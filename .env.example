# =====================================================================
# DataMind AI - Production Environment Variables Template (.env.example)
# =====================================================================

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/analytics_platform
DB_HOST=localhost
DB_PORT=5432
DB_NAME=analytics_platform
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Authentication & Cryptography (JWT & bcrypt)
JWT_SECRET=change_this_to_a_random_cryptographic_64_char_hex_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
BCRYPT_ROUNDS=12

# Application Settings
ENVIRONMENT=production
DEBUG=false
ALLOWED_ORIGINS=*
DATASET_STORAGE_DIR=./storage/datasets

# SMTP Mail Gateway (Gmail / Custom SMTP Relay)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_SENDER=your_email@gmail.com
SMTP_USE_TLS=true

